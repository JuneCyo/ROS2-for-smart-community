<?xml version="1.0" ?>
<!-- 4 分类垃圾桶: 与楼宇同一排(由西往东: 楼宇A/B/C → 有害/可回收/厨余/其他), 标签朝北 + 朝南 -->
<sdf version="1.6">
  <model name="trash_bins">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>
    <link name="bin_hazardous">
      <pose>0.9 0 0 0 0 0</pose>
      <collision name="col">
        <geometry><box><size>0.62 0.46 0.92</size></box></geometry>
