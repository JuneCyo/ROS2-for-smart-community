<?xml version="1.0"?>
<sdf version="1.6">
  <world name="competition_world">
  <plugin name="traffic_signal_plugin" filename="libtraffic_signal_plugin.so"/>
  
<plugin name="gazebo_ros" filename="libgazebo_ros.so">
  <ros>
    <namespace>/</namespace>
  </ros>
</plugin>

    <!-- Physics -->
    <physics name="default_physics" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_update_rate>500</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- sky、light -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <!-- competition_ground -->
    <include>
      <uri>model://competition_ground</uri>
    </include>

    <!-- The start box and east lane are closed by painted cross-lines.  These
         road-colored, visual-only gaps give the closed navigation loop a clear
         lane; they do not change the laser/occupancy collision map. -->
    <model name="navigation_line_gaps">
      <static>true</static>
      <link name="paint">
        <visual name="start_exit"><pose>3.95 -3.32 0.051 0 0 0</pose><geometry><box><size>0.80 0.12 0.002</size></box></geometry><material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.015 0.015 0.015 1</diffuse></material></visual>
        <visual name="east_lower"><pose>3.95 -1.88 0.051 0 0 0</pose><geometry><box><size>0.80 0.12 0.002</size></box></geometry><material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.015 0.015 0.015 1</diffuse></material></visual>
        <visual name="east_middle"><pose>3.95 -0.47 0.051 0 0 0</pose><geometry><box><size>0.80 0.12 0.002</size></box></geometry><material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.015 0.015 0.015 1</diffuse></material></visual>
        <visual name="east_upper"><pose>3.95 3.32 0.051 0 0 0</pose><geometry><box><size>0.80 0.12 0.002</size></box></geometry><material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.015 0.015 0.015 1</diffuse></material></visual>
        <visual name="north_exit"><pose>3.31 3.80 0.051 0 0 0</pose><geometry><box><size>0.18 0.80 0.002</size></box></geometry><material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.015 0.015 0.015 1</diffuse></material></visual>
        <visual name="north_descent"><pose>1.05 3.32 0.051 0 0 0</pose><geometry><box><size>0.80 0.12 0.002</size></box></geometry><material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.015 0.015 0.015 1</diffuse></material></visual>
        <visual name="middle_exit"><pose>0.48 0.10 0.051 0 0 0</pose><geometry><box><size>0.18 0.80 0.002</size></box></geometry><material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.015 0.015 0.015 1</diffuse></material></visual>
        <visual name="inner_west_exit"><pose>-0.98 0.10 0.051 0 0 0</pose><geometry><box><size>0.18 0.80 0.002</size></box></geometry><material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.015 0.015 0.015 1</diffuse></material></visual>
        <visual name="west_exit"><pose>-3.31 0.10 0.051 0 0 0</pose><geometry><box><size>0.18 0.80 0.002</size></box></geometry><material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.015 0.015 0.015 1</diffuse></material></visual>
        <!-- Keep the horizontal plate-facing line at y=-3.35 intact. -->
        <visual name="south_west_exit"><pose>-3.31 -2.90 0.051 0 0 0</pose><geometry><box><size>0.18 0.70 0.002</size></box></geometry><material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.015 0.015 0.015 1</diffuse></material></visual>
        <visual name="south_inner_west"><pose>-0.98 -2.90 0.051 0 0 0</pose><geometry><box><size>0.18 0.70 0.002</size></box></geometry><material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.015 0.015 0.015 1</diffuse></material></visual>
        <visual name="south_middle"><pose>0.48 -2.90 0.051 0 0 0</pose><geometry><box><size>0.18 0.70 0.002</size></box></geometry><material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.015 0.015 0.015 1</diffuse></material></visual>
        <visual name="south_inner_east"><pose>1.85 -2.90 0.051 0 0 0</pose><geometry><box><size>0.18 0.70 0.002</size></box></geometry><material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.015 0.015 0.015 1</diffuse></material></visual>
        <visual name="south_east_exit"><pose>3.31 -2.90 0.051 0 0 0</pose><geometry><box><size>0.18 0.70 0.002</size></box></geometry><material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.015 0.015 0.015 1</diffuse></material></visual>
      </link>
    </model>

<!-- PersonA -->
<include>
  <uri>model://Person_A</uri>
  <pose>2.5 2.0 0 0 0 1.5708</pose>
</include>

<!-- PersonB -->
<include>
  <uri>model://Person_B</uri>
  <pose>2.5 2.0 0 0 0 4.7124</pose>
</include>

<!-- Car1 -->
<include>
  <uri>model://Car1</uri>
  <pose>-1.2 -4 0 0 0 0</pose>
</include>

<!-- Car2 -->
<include>
  <uri>model://Car2</uri>
  <pose>-2.6 -4 0 0 0 0</pose>
</include>

<!-- Car3 -->
<include>
  <uri>model://Car3</uri>
  <pose>-4.0 -4 0 0 0 0</pose>
</include>

<!-- traffic_light1 -->
<include>
  <uri>model://traffic_light1</uri>
  <pose>4.0 0 0 0 0 3.1416</pose>
</include>

<!-- traffic_light2 -->
<include>
  <uri>model://traffic_light2</uri>
  <pose>-2 0.25 0 0 0 4.7124</pose>
</include>



  


















<!-- ==== 自动生成: 楼宇A/B/C 与 垃圾桶 (gen_buildings_bins.py) ==== -->
<!-- 楼宇A -->
<include>
  <uri>model://building_a</uri>
  <name>building_a</name>
  <pose>0.10 -1.3 0.5 0 0 0</pose>
</include>
<!-- 楼宇B -->
<include>
  <uri>model://building_b</uri>
  <name>building_b</name>
  <pose>1.40 -1.3 0.5 0 0 0</pose>
</include>
<!-- 楼宇C -->
<include>
  <uri>model://building_c</uri>
  <name>building_c</name>
  <pose>2.7 -1.3 0.5 0 0 0</pose>
</include>
<!-- 垃圾桶(4 分类): 与楼宇同一排, x = 0.90 ~ 3.00, y = -2.60 -->
<include>
  <uri>model://trash_bins</uri>
  <name>trash_bins</name>
  <pose>-3.9 -1.3 0 0 0 0</pose>
</include>
<!-- ==== 自动生成结束 ==== -->

</world>
</sdf>

