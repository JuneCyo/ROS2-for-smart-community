<?xml version="1.0"?>
<!-- 临时俯视相机: 放在白线方框正上方往下拍, 用来核对机器人确实在方框内
     注意: 旋转写在 <link><pose> 里, 因为 spawn_entity 的 -x/-y/-z 会覆盖模型位姿 -->
<sdf version="1.6">
  <model name="overhead_check">
    <static>true</static>
    <pose>0 0 0 0 0 0</pose>
    <link name="cam_link">
      <pose>0 0 1.6 0 1.5707963 1.5707963</pose>
      <visual name="cam_vis">
        <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
      </visual>
      <sensor name="cam" type="camera">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>2.0</update_rate>
        <camera>
          <horizontal_fov>1.6</horizontal_fov>
          <image><width>800</width><height>800</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>20.0</far></clip>
        </camera>
        <plugin name="cam_ctrl" filename="libgazebo_ros_camera.so">
          <ros><namespace>/</namespace></ros>
          <camera_name>overhead_check</camera_name>
          <frame_name>cam_link</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>
